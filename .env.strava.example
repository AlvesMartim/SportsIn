# Fichier de configuration Strava (exemple)
# Copiez ce fichier en .env.strava et remplissez vos vraies valeurs.
# Ce fichier est versionné (sans secrets). .env.strava ne l'est pas.
#
# Pour créer une app Strava :
# 1. Aller sur https://www.strava.com/settings/api
# 2. Créer une application
# 3. Copier Client ID et Client Secret ci-dessous
# 4. Mettre http://localhost:8080/api/strava/callback dans "Authorization Callback Domain"

STRAVA_CLIENT_ID=votre_client_id_ici
STRAVA_CLIENT_SECRET=votre_client_secret_ici
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback
STRAVA_VERIFY_TOKEN=sportsin_webhook_verify
